{
  "functions": {
    "api/**/*.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    { "src": "/bpk-penabur", "dest": "/bpk-penabur.html" },
    { "src": "/bpk-penabur.html", "dest": "/bpk-penabur.html" },
    { "src": "/uploads/(.*)", "dest": "/uploads/$1" },
    { "src": "/(.*)", "dest": "/index.php" }
  ]
}
